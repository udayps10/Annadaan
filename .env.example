# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_database_password
DB_NAME=foodrescue
DB_PORT=3306
DB_CONNECTION_LIMIT=50

# ============================================
# AUTHENTICATION & SECURITY (REQUIRED)
# ============================================
# CRITICAL: Generate a strong random secret for JWT signing
# Example: openssl rand -base64 64
# NEVER use the default value in production!
JWT_SECRET=your_super_secure_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ============================================
# EMAIL CONFIGURATION (REQUIRED)
# ============================================
# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM_NAME=Annadaan

# ============================================
# APPLICATION CONFIGURATION
# ============================================
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# ============================================
# UPLOAD CONFIGURATION
# ============================================
# Max file size in bytes (default: 5MB = 5242880)
MAX_FILE_SIZE=5242880
# Image quality (0.1 to 1.0, default: 0.8)
IMAGE_QUALITY=0.8
MAX_IMAGE_WIDTH=1920
MAX_IMAGE_HEIGHT=1080

# ============================================
# DONATION CONFIGURATION
# ============================================
UPI_ID=annadaan@paytm
UPI_NAME=Annadaan Foundation
MIN_DONATION_AMOUNT=1
MAX_DONATION_AMOUNT=100000

# ============================================
# RATE LIMITING
# ============================================
# Rate limit window in milliseconds (default: 15 minutes = 900000)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window (default: 100)
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FEATURE FLAGS (OPTIONAL)
# ============================================
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_PDF_RECEIPTS=true
FEATURE_IMAGE_COMPRESSION=true

# ============================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================
# Before deploying to production, ensure:
# 1. JWT_SECRET is a strong, randomly generated secret (at least 32 characters)
# 2. All database credentials are secure and unique
# 3. SMTP credentials are configured with app-specific passwords
# 4. NODE_ENV is set to "production"
# 5. NEXT_PUBLIC_BASE_URL is set to your actual domain
# 6. All file permissions are set correctly
# 7. SSL/TLS certificates are configured
# 8. Firewall rules are properly set
# 9. Database backups are configured
# 10. Monitoring and logging are set up

# ============================================
# DEVELOPMENT NOTES
# ============================================
# For Gmail SMTP:
# 1. Enable 2-factor authentication on your Gmail account
# 2. Generate an app-specific password: https://myaccount.google.com/apppasswords
# 3. Use the app password in SMTP_PASS (not your regular Gmail password)
#
# For JWT_SECRET generation:
# Run: openssl rand -base64 64
# Or use: https://www.grc.com/passwords.htm (Perfect Passwords section)
#
# Database Setup:
# 1. Create a MySQL database with name matching DB_NAME
# 2. Create a dedicated user with appropriate permissions
# 3. Grant privileges: GRANT ALL PRIVILEGES ON foodrescue.* TO 'username'@'localhost';
